@{
	ViewData["Title"] = "MovieDetail";
	Layout = "~/Views/UserWebUILayout/UserWebUILayout.cshtml";
}

<style>
	.tabs-mv {
		display: flex !important;
		justify-content: flex-start !important;
		flex-wrap: nowrap !important;
		gap: 20px !important;
	}

		.tabs-mv li {
			margin: 0 !important;
		}

			.tabs-mv li a {
				white-space: nowrap !important;
				padding-left: 5px !important;
				padding-right: 5px !important;
				font-size: 13px !important;
			}
</style>

<div class="hero mv-single-hero">
	<div class="container">
		<div class="row">
			<div class="col-md-12">
				<!-- <h1> movie listing - list</h1>
				<ul class="breadcumb">
					<li class="active"><a href="#">Home</a></li>
					<li> <span class="ion-ios-arrow-right"></span> movie listing</li>
				</ul> -->
			</div>
		</div>
	</div>
</div>

<div class="page-single movie-single movie_single">
	<div class="container">
		<div class="row ipad-width2">
			@await Component.InvokeAsync("_MovieImageAndWatchTrailerComponentPartial")
			<div class="col-md-8 col-sm-12 col-xs-12">
				<div class="movie-single-ct main-content">
					<h1 class="bd-hd">Skyfall: Quantum of Spectre <span>2015</span></h1>
					@await Component.InvokeAsync("_MovieDetailShareSocialMediaComponentPartial")
					@await Component.InvokeAsync("_MovieDetailRateComponentPartial")

					<div class="movie-tabs">
						<div class="tabs">
							<ul class="tab-links tabs-mv">
								<li class="active"><a href="#overview">Genel</a></li>
								<li><a href="#reviews">Yorumlar</a></li>
								<li><a href="#cast">Oyuncular</a></li>
								<li><a href="#media">Fragmanlar</a></li>
								<li><a href="#moviesrelated">Benzer Filmler</a></li>
							</ul>
							<div class="tab-content">
								@await Component.InvokeAsync("_MovieDetailOverviewComponentPartial")
								@await Component.InvokeAsync("_MovieDetailReviewComponentPartial")
								@await Component.InvokeAsync("_MovieDetailCastComponentPartial")
								@await Component.InvokeAsync("_MovieDetailMediaComponentPartial")
								@await Component.InvokeAsync("_MovieDetailRelatedMovieComponentPartial")
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>