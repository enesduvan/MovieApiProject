@{
    ViewData["Title"] = "Film Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    /* Modern Tablo ve Kart Tasarımı */
    .modern-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        margin-bottom: 24px;
        overflow: hidden;
    }

        .modern-card .card-body {
            padding: 24px;
        }

    .table-header-title {
        font-size: 17px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .table-header-title ion-icon {
            font-size: 22px;
            color: #9b51e0;
            background: rgba(155, 81, 224, 0.12);
            padding: 8px;
            border-radius: 10px;
        }

    /* Arama Kutusu */
    .modern-search .form-control {
        border-radius: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        border: 1px solid rgba(155, 81, 224, 0.25);
        transition: all 0.25s ease;
    }

        .modern-search .form-control:focus {
            border-color: #9b51e0;
            box-shadow: 0 0 0 3px rgba(155, 81, 224, 0.15);
        }

    /* Tablo Satırları ve Başlıkları */
    .modern-table thead th {
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        font-weight: 600;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .modern-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        font-size: 14px;
    }

    .modern-table tbody tr {
        transition: background-color 0.2s ease;
    }

        .modern-table tbody tr:hover {
            background-color: rgba(155, 81, 224, 0.04);
        }

    /* Film Afiş Görseli */
    .movie-poster-thumb {
        width: 46px;
        height: 62px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    }

    /* Puan Rozeti */
    .rating-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(234, 179, 8, 0.15);
        color: #eab308;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 13px;
    }

    /* İşlem Butonları (Görüntüle, Düzenle, Sil) */
    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .action-btn.view {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
        }

            .action-btn.view:hover {
                background: #3b82f6;
                color: #ffffff;
            }

        .action-btn.edit {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
        }

            .action-btn.edit:hover {
                background: #f59e0b;
                color: #ffffff;
            }

        .action-btn.delete {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
        }

            .action-btn.delete:hover {
                background: #ef4444;
                color: #ffffff;
            }
</style>

<!-- 1. TABLO: FİLM YÖNETİM LİSTESİ -->
