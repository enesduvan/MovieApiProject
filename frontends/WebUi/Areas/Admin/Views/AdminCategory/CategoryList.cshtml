@model List<AdminResultCategoryDto>
@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-body">
        <!-- Kart Üst Başlık ve Butonlar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <h5 class="mb-1 d-flex align-items-center gap-2">
                    <i class="bx bx-category text-primary fs-4"></i>
                    <span>Kategori Listesi ve Yönetim Paneli</span>
                </h5>
                <p class="text-muted mb-0 small ps-4">
                    Sistemde toplam <strong>@(Model?.Count ?? 0)</strong> kategori listelenmektedir.
                </p>
            </div>

            <div>
                <a href="/Admin/AdminCategory/CreateCategory" class="btn btn-primary d-inline-flex align-items-center gap-1">
                    <i class="bx bx-plus-circle fs-5"></i>
                    <span>Yeni Kategori Ekle</span>
                </a>
            </div>
        </div>

        <!-- Kategori Tablosu -->
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>KATEGORİ ADI</th>
                        <th>FİLM SAYISI</th>
                        <th>ORT. PUAN</th>
                        <th>YORUM SAYISI</th>
                        <th>AÇIKLAMA</th>
                        <th>DURUM</th>
                        <th class="text-center" style="width: 90px;">SİL</th>
                        <th class="text-center" style="width: 100px;">GÜNCELLE</th>
                        <th class="text-center" style="width: 100px;">DETAYLAR</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">@item.CategoryId</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="fs-4 text-primary">
                                            <i class="bx bx-folder"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@item.CategoryName</h6>
                                            <small class="text-muted">#CAT-@item.CategoryId.ToString("D3")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light-primary text-primary px-3 py-2">
                                        <i class="bx bx-film me-1"></i>@item.MovieCount Film
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light-warning text-warning px-3 py-2">
                                        <i class="bx bxs-star me-1"></i>@item.AverageRating.ToString("0.0")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light-info text-info px-3 py-2">
                                        <i class="bx bx-comment-detail me-1"></i>@item.ReviewCount Yorum
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted d-block text-truncate" style="max-width: 250px;" title="@item.Description">
                                        @(string.IsNullOrEmpty(item.Description) ? "Açıklama belirtilmemiş" : item.Description)
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == true)
                                    {
                                        <span class="badge bg-light-success text-success px-3 py-2">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light-secondary text-secondary px-3 py-2">Pasif</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Admin/AdminCategory/DeleteCategory/@item.CategoryId" 
                                       onclick="return confirm('@item.CategoryName kategorisini silmek istediğinize emin misiniz?');" 
                                       class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" 
                                       title="Kategoriyi Sil">
                                        <i class="bx bx-trash"></i>
                                        <span>Sil</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a href="javascript:;" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1" title="Kategoriyi Güncelle">
                                        <i class="bx bx-edit"></i>
                                        <span>Güncelle</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a href="javascript:;" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" title="Kategori Detayları">
                                        <i class="bx bx-show"></i>
                                        <span>Detaylar</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bx bx-category fs-1 opacity-50"></i>
                                    <h6 class="mt-3 mb-1">Henüz Kayıtlı Kategori Bulunamadı</h6>
                                    <p class="small mb-3">Veritabanında kayıtlı kategori yok veya WebApi servisine henüz bağlanılamadı.</p>
                                    <a href="/Admin/AdminCategory/CreateCategory" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-plus me-1"></i> Yeni Kategori Ekle
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Kart Alt Bilgi -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small">
                © @DateTime.Now.Year Kategori Yönetim Sistemi • MovieApiProject Admin Paneli
            </span>
            <a href="/Admin/AdminCategory/CreateCategory" class="btn btn-sm btn-outline-primary">
                <i class="bx bx-plus me-1"></i> Yeni Kategori Ekle
            </a>
        </div>
    </div>
</div>
