@model AdminCreateMovieDto
@{
    ViewData["Title"] = "Yeni Film Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <!-- Kart Üst Başlık ve Geri Dön Butonu -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="fs-2 text-primary">
                    <i class="bx bx-film"></i>
                </div>
                <div>
                    <h5 class="mb-1">Yeni Film Ekle</h5>
                    <p class="text-muted mb-0 small">Sisteme yeni bir film kaydı tanımlayın.</p>
                </div>
            </div>
            <a href="/Admin/AdminMovie/MovieList" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="bx bx-arrow-back fs-5"></i>
                <span>Listeye Dön</span>
            </a>
        </div>

        <!-- Form Alanı -->
        <form asp-area="Admin" asp-controller="AdminMovie" asp-action="CreateMovie" method="post">
            <div class="row g-4 mb-4">
                <!-- Film Adı -->
                <div class="col-12 col-lg-8">
                    <label asp-for="Title" class="form-label fw-bold">
                        Film Adı <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-movie text-primary fs-5"></i>
                        </span>
                        <input type="text" 
                               asp-for="Title" 
                               class="form-control form-control-lg" 
                               placeholder="Örn: Inception, Interstellar, The Dark Knight..." 
                               required 
                               autofocus 
                               autocomplete="off" />
                    </div>
                </div>

                <!-- Film Durumu -->
                <div class="col-12 col-lg-4">
                    <label asp-for="Status" class="form-label fw-bold">
                        Vizyon Durumu <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-toggle-right text-primary fs-5"></i>
                        </span>
                        <select asp-for="Status" class="form-select form-select-lg">
                            <option value="Vizyonda" selected>Vizyonda</option>
                            <option value="Yakında">Yakında</option>
                            <option value="Arşiv">Arşiv</option>
                            <option value="Pasif">Pasif</option>
                        </select>
                    </div>
                </div>

                <!-- IMDb Puanı -->
                <div class="col-12 col-md-4">
                    <label asp-for="Rating" class="form-label fw-bold">
                        Puan (IMDb / Rating) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bxs-star text-warning fs-5"></i>
                        </span>
                        <input type="number" 
                               step="0.1" 
                               min="0" 
                               max="10" 
                               asp-for="Rating" 
                               class="form-control form-control-lg" 
                               placeholder="Örn: 8.8" 
                               required />
                    </div>
                </div>

                <!-- Süre (Dakika) -->
                <div class="col-12 col-md-4">
                    <label asp-for="Duration" class="form-label fw-bold">
                        Süre (Dakika) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-time-five text-primary fs-5"></i>
                        </span>
                        <input type="number" 
                               min="1" 
                               asp-for="Duration" 
                               class="form-control form-control-lg" 
                               placeholder="Örn: 148" 
                               required />
                    </div>
                </div>

                <!-- Çıkış Yılı -->
                <div class="col-12 col-md-4">
                    <label asp-for="CreatedYear" class="form-label fw-bold">
                        Çıkış Yılı <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-calendar-event text-primary fs-5"></i>
                        </span>
                        <input type="text" 
                               asp-for="CreatedYear" 
                               class="form-control form-control-lg" 
                               placeholder="Örn: 2014" 
                               required />
                    </div>
                </div>

                <!-- Vizyon Tarihi -->
                <div class="col-12 col-lg-6">
                    <label asp-for="ReleaseDate" class="form-label fw-bold">
                        Vizyon Tarihi <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-calendar text-primary fs-5"></i>
                        </span>
                        <input type="date" 
                               asp-for="ReleaseDate" 
                               class="form-control form-control-lg" 
                               required />
                    </div>
                </div>

                <!-- Afiş Görsel URL -->
                <div class="col-12 col-lg-6">
                    <label asp-for="CoverImageUrl" class="form-label fw-bold">
                        Afiş Görsel URL <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-image text-primary fs-5"></i>
                        </span>
                        <input type="url" 
                               asp-for="CoverImageUrl" 
                               class="form-control form-control-lg" 
                               placeholder="https://.../poster.jpg" 
                               required />
                    </div>
                </div>

                <!-- Açıklama / Film Özeti -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold">
                        Film Konusu / Açıklama <span class="text-muted small fw-normal">(İsteğe Bağlı)</span>
                    </label>
                    <textarea asp-for="Description" 
                              class="form-control" 
                              rows="4" 
                              placeholder="Filmin konusu, özeti veya dikkat çeken detayları hakkında bilgi girin..."></textarea>
                </div>
            </div>

            <!-- Alt Aksiyon Butonları -->
            <div class="d-flex align-items-center gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2">
                    <i class="bx bx-check-circle fs-5"></i>
                    <span>Filmi Kaydet</span>
                </button>
                <a href="/Admin/AdminMovie/MovieList" class="btn btn-outline-secondary px-4 py-2 d-inline-flex align-items-center gap-2">
                    <i class="bx bx-x fs-5"></i>
                    <span>Vazgeç</span>
                </a>
            </div>
        </form>
    </div>
</div>
