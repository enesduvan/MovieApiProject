@model List<AdminResultMovieDto>
@{
    ViewData["Title"] = "Film Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-body">
        <!-- Kart Üst Başlık ve Butonlar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <h5 class="mb-1 d-flex align-items-center gap-2">
                    <i class="bx bx-film text-primary fs-4"></i>
                    <span>Film Listesi ve Yönetim Paneli</span>
                </h5>
                <p class="text-muted mb-0 small ps-4">
                    Sistemde toplam <strong>@(Model?.Count ?? 0)</strong> film listelenmektedir.
                </p>
            </div>

            <div>
                <a href="/Admin/AdminMovie/CreateMovie" class="btn btn-primary d-inline-flex align-items-center gap-1">
                    <i class="bx bx-plus-circle fs-5"></i>
                    <span>Yeni Film Ekle</span>
                </a>
            </div>
        </div>

        <!-- Film Tablosu -->
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>FİLM BİLGİSİ</th>
                        <th>PUAN</th>
                        <th>SÜRE</th>
                        <th>ÇIKIŞ YILI</th>
                        <th>VİZYON TARİHİ</th>
                        <th>DURUM</th>
                        <th class="text-center" style="width: 90px;">SİL</th>
                        <th class="text-center" style="width: 100px;">GÜNCELLE</th>
                        <th class="text-center" style="width: 100px;">DETAYLAR</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">@item.MovieId</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@item.CoverImageUrl" 
                                             class="rounded" 
                                             style="width: 46px; height: 64px; object-fit: cover;" 
                                             alt="@item.Title">
                                        <div>
                                            <h6 class="mb-0">@item.Title</h6>
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@item.Description">
                                                @(string.IsNullOrEmpty(item.Description) ? "Açıklama belirtilmemiş" : item.Description)
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light-warning text-warning px-3 py-2">
                                        <i class="bx bxs-star me-1"></i> @item.Rating
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bx bx-time-five me-1"></i>@(item.Duration > 0 ? item.Duration + " Dk" : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light-primary text-primary px-3 py-2">
                                        @(string.IsNullOrEmpty(item.CreatedYear) ? "-" : item.CreatedYear)
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bx bx-calendar me-1"></i>@(item.ReleaseDate != default ? item.ReleaseDate.ToString("dd.MM.yyyy") : "-")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "True" || item.Status == "Vizyonda" || item.Status == "Aktif")
                                    {
                                        <span class="badge bg-light-success text-success px-3 py-2">Vizyonda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light-secondary text-secondary px-3 py-2">@(string.IsNullOrEmpty(item.Status) ? "Pasif" : item.Status)</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Admin/AdminMovie/DeleteMovie/@item.MovieId" 
                                       onclick="return confirm('@item.Title filmini silmek istediğinize emin misiniz?');" 
                                       class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" 
                                       title="Filmi Sil">
                                        <i class="bx bx-trash"></i>
                                        <span>Sil</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a href="javascript:;" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1" title="Filmi Güncelle">
                                        <i class="bx bx-edit"></i>
                                        <span>Güncelle</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a href="javascript:;" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" title="Film Detayları">
                                        <i class="bx bx-show"></i>
                                        <span>Detaylar</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bx bx-film fs-1 opacity-50"></i>
                                    <h6 class="mt-3 mb-1">Henüz Kayıtlı Film Bulunamadı</h6>
                                    <p class="small mb-3">Veritabanında kayıtlı film yok veya API bağlantısı sağlanamadı.</p>
                                    <a href="/Admin/AdminMovie/CreateMovie" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-plus me-1"></i> Yeni Film Ekle
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Kart Alt Bilgi -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4 pt-3 border-top">
            <span class="text-muted small">
                © @DateTime.Now.Year Film Yönetim Sistemi • MovieApiProject Admin Paneli
            </span>
            <a href="/Admin/AdminMovie/CreateMovie" class="btn btn-sm btn-outline-primary">
                <i class="bx bx-plus me-1"></i> Yeni Film Ekle
            </a>
        </div>
    </div>
</div>
